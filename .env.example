# Dev only; EC2 uses instance role.
AWS_PROFILE=
AWS_REGION=us-east-1

# Bedrock and Decider model configuration (not used in Milestone 1).
AITE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AITE_BENCH_JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AITE_DECIDER_URL=http://127.0.0.1:8000
AITE_DECIDER_MODEL=
AITE_DECIDER_HOST_LABEL=local-cpu
AITE_DECIDER_THRESHOLD=0.75
AITE_DECIDER_TIMEOUT_SECONDS=30

# Artifact root for run outputs (gitignored).
AITE_ARTIFACT_ROOT=./runs

# Mock payment service -- controls the injected duplicate-ledger defect.
AITE_DUPLICATE_LEDGER_DEFECT=true

# Timeouts for generation and pytest execution (not used in Milestone 1).
AITE_GENERATION_TIMEOUT_SECONDS=120
AITE_PYTEST_TIMEOUT_SECONDS=60
